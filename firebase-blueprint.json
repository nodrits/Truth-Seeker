{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and progress tracking",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "streakCount": { "type": "number" },
        "lastActiveDate": { "type": "string", "format": "date-time" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "readingProgress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Prayer": {
      "title": "Prayer",
      "description": "A prayer request or praise report on the community wall",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPublic": { "type": "boolean" },
        "likes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "text", "createdAt"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "A private reflection or prayer journal entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "prompt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "mood": { "type": "string" }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message in an AI Bible chat session",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and progress data"
    },
    "/users/{userId}/journal": {
      "schema": "JournalEntry",
      "description": "Private journal entries for a user"
    },
    "/users/{userId}/chatHistory": {
      "schema": "ChatMessage",
      "description": "AI chat history for a user"
    },
    "/prayers/{prayerId}": {
      "schema": "Prayer",
      "description": "Community prayer wall entries"
    }
  }
}
