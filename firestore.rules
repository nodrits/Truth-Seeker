rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Connectivity Test
    match /_connection_test_/{docId} {
      allow get: if isSignedIn();
    }

    // User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'createdAt']) 
          && data.uid == request.auth.uid 
          && data.email is string
          && data.createdAt is string
          && (data.streakCount == null || data.streakCount is number)
          && (data.displayName == null || data.displayName is string)
          && (data.photoURL == null || data.photoURL is string)
          && (data.lastActiveDate == null || data.lastActiveDate is string)
          && (data.badges == null || data.badges is list)
          && (data.readingProgress == null || data.readingProgress is map);
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'streakCount', 'lastActiveDate', 'readingProgress', 'badges'])
      );

      // Journal Entries
      match /journal/{entryId} {
        function isValidEntry(data) {
          return data.keys().hasAll(['userId', 'content', 'createdAt'])
            && data.userId == request.auth.uid
            && data.content is string && data.content.size() <= 5000;
        }
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEntry(incoming());
        allow delete: if isOwner(userId);
      }

      // Chat History
      match /chatHistory/{msgId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // Community Prayers
    match /prayers/{prayerId} {
      function isValidPrayer(data) {
        return data.keys().hasAll(['userId', 'text', 'createdAt'])
          && data.userId == request.auth.uid
          && data.text is string && data.text.size() <= 1000;
      }
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidPrayer(incoming());
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
